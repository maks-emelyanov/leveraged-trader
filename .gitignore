# Runtime workflow locks for conventional SQLite database names and output directories.
*.sqlite.lock
*.sqlite3.lock
*.db.lock
.leveraged-trader.lock
.leveraged-trader-output-*.lock
# Private SQLite creation stages can survive an interrupted first publication.
.leveraged-trader-sqlite-*.tmp
